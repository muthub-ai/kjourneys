{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:kos:schema:kos-journey:0.5.0",
 "title": "KOS Journey Ontology instance",
 "type": "object",
 "additionalProperties": false,
 "patternProperties": {
  "^x-": {}
 },
 "required": [
  "ontology",
  "codelists",
  "sources",
  "parties",
  "products",
  "capabilities",
  "applications",
  "metrics",
  "processes",
  "controls",
  "journeys"
 ],
 "properties": {
  "ontology": {
   "const": "kos-journey/0.5.0"
  },
  "codelists": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "stages",
    "evidence_basis",
    "layers",
    "channels"
   ],
   "properties": {
    "stages": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "name"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/slug"
       },
       "name": {
        "type": "string"
       },
       "customer_goal": {
        "type": "string"
       }
      },
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "evidence_basis": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/basis"
     }
    },
    "layers": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "channels": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "patternProperties": {
    "^x-": {}
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "title"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "placeholder",
       "walkthrough",
       "screenshot",
       "web-page",
       "filing",
       "network-rule",
       "internal-system",
       "kos-bundle",
       "interview",
       "mi-report"
      ]
     },
     "title": {
      "type": "string"
     },
     "origin": {
      "type": "string"
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     },
     "retrieved_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "path": {
      "type": "string",
      "pattern": "^reports/\\d{4}-\\d{2}-\\d{2}-v\\d+/.+"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "report_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-v\\d+$"
     }
    },
    "patternProperties": {
     "^x-": {}
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "kind": {
         "const": "mi-report"
        }
       }
      },
      "then": {
       "required": [
        "path",
        "sha256",
        "report_version"
       ]
      }
     }
    ]
   }
  },
  "parties": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "role"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/slug"
     },
     "name": {
      "type": "string"
     },
     "lei": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^[A-Z0-9]{18}[0-9]{2}$"
     },
     "lei_basis": {
      "$ref": "#/$defs/basis"
     },
     "role": {
      "enum": [
       "focus",
       "competitor",
       "network",
       "vendor"
      ]
     }
    },
    "patternProperties": {
     "^x-": {}
    }
   }
  },
  "products": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "family"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/slug"
     },
     "name": {
      "type": "string"
     },
     "family": {
      "enum": [
       "zelle",
       "ach",
       "wire",
       "bill-pay",
       "instant",
       "card-transfer",
       "other"
      ]
     },
     "fibo_class": {
      "type": [
       "string",
       "null"
      ]
     },
     "journeys": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/urn"
      }
     }
    },
    "patternProperties": {
     "^x-": {}
    }
   }
  },
  "capabilities": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "basis"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^cap-[a-z0-9-]+$"
     },
     "name": {
      "type": "string"
     },
     "bian_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "bian_version": {
      "type": [
       "string",
       "null"
      ]
     },
     "basis": {
      "$ref": "#/$defs/basis"
     },
     "note": {
      "type": "string"
     }
    },
    "patternProperties": {
     "^x-": {}
    }
   }
  },
  "applications": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "app_id",
     "name",
     "layer",
     "owner_team",
     "capabilities",
     "bundle",
     "basis"
    ],
    "properties": {
     "app_id": {
      "type": "string",
      "pattern": "^([a-z0-9]{5}|ext-[a-z-]+)$"
     },
     "name": {
      "type": "string"
     },
     "layer": {
      "enum": [
       "channel",
       "security",
       "orchestration",
       "integration",
       "core",
       "risk",
       "platform",
       "operations",
       "external"
      ]
     },
     "owner_team": {
      "type": "string"
     },
     "capabilities": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "bundle": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^application-bundles/[a-z0-9]{5}/$"
     },
     "cmdb_ci": {
      "type": [
       "string",
       "null"
      ]
     },
     "depends_on": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "basis": {
      "$ref": "#/$defs/basis"
     }
    },
    "patternProperties": {
     "^x-": {}
    }
   }
  },
  "metrics": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "definition",
     "formula",
     "unit",
     "grain",
     "period",
     "direction",
     "source_system",
     "dq_status",
     "basis",
     "bank",
     "product"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^met-[a-z0-9-]+$"
     },
     "name": {
      "type": "string"
     },
     "definition": {
      "type": "string"
     },
     "formula": {
      "type": "string"
     },
     "unit": {
      "enum": [
       "percent",
       "bps",
       "ms",
       "seconds",
       "days",
       "count",
       "usd",
       "per_1000"
      ]
     },
     "grain": {
      "enum": [
       "transaction",
       "customer",
       "event",
       "case",
       "day"
      ]
     },
     "period": {
      "enum": [
       "daily",
       "monthly",
       "quarterly"
      ]
     },
     "direction": {
      "enum": [
       "increase",
       "decrease",
       "monitor"
      ]
     },
     "source_system": {
      "type": "string"
     },
     "steward": {
      "type": [
       "string",
       "null"
      ]
     },
     "dq_status": {
      "enum": [
       "certified",
       "provisional",
       "uncertified"
      ]
     },
     "basis": {
      "$ref": "#/$defs/basis"
     },
     "bank": {
      "type": "string"
     },
     "product": {
      "type": "string"
     },
     "scale": {
      "enum": [
       "0-100",
       "0-1"
      ]
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "unit": {
         "const": "percent"
        }
       }
      },
      "then": {
       "required": [
        "scale"
       ]
      }
     }
    ],
    "patternProperties": {
     "^x-": {}
    }
   }
  },
  "processes": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "steps"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/urn"
     },
     "code": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "steps": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "owner": {
      "$ref": "#/$defs/principal"
     },
     "basis": {
      "$ref": "#/$defs/basis"
     }
    },
    "patternProperties": {
     "^x-": {}
    }
   }
  },
  "controls": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "text",
     "type",
     "design",
     "automation"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/urn"
     },
     "text": {
      "type": "string"
     },
     "type": {
      "enum": [
       "fraud",
       "aml",
       "regulatory",
       "operational",
       "security"
      ]
     },
     "design": {
      "enum": [
       "preventive",
       "detective",
       "corrective",
       null
      ]
     },
     "automation": {
      "enum": [
       "manual",
       "automated",
       "hybrid",
       null
      ]
     },
     "key_control": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "grc_control_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "risk_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "regulation": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "basis": {
      "$ref": "#/$defs/basis"
     }
    },
    "patternProperties": {
     "^x-": {}
    }
   }
  },
  "journeys": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/journey"
   }
  },
  "portfolio": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "focus_bank",
    "banks",
    "products"
   ],
   "properties": {
    "focus_bank": {
     "type": "string"
    },
    "banks": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "banks_note": {
     "type": "string"
    },
    "products": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "patternProperties": {
    "^x-": {}
   }
  },
  "comparison": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "product",
    "attributes",
    "values",
    "governance"
   ],
   "properties": {
    "product": {
     "type": "string"
    },
    "attributes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "stage",
       "name",
       "datatype",
       "normalization"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^attr-[a-z0-9-]+$"
       },
       "stage": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "datatype": {
        "enum": [
         "text",
         "integer",
         "boolean",
         "money",
         "duration",
         "enum",
         "enum_list"
        ]
       },
       "unit": {
        "type": [
         "string",
         "null"
        ]
       },
       "normalization": {
        "type": "string"
       },
       "allowed_values": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "minItems": 1
       }
      },
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "values": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/assertion"
       }
      }
     }
    },
    "governance": {
     "$ref": "#/$defs/governance"
    }
   },
   "patternProperties": {
    "^x-": {}
   }
  }
 },
 "$defs": {
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "urn": {
   "type": "string",
   "pattern": "^urn:kos:[a-z]+:[a-z0-9-]+(:[a-z0-9-]+)*$"
  },
  "basis": {
   "enum": [
    "observed",
    "disclosed",
    "inferred",
    "internal",
    "sample",
    "awaiting"
   ]
  },
  "assertion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "basis"
   ],
   "properties": {
    "value": {},
    "display": {
     "type": "string"
    },
    "basis": {
     "$ref": "#/$defs/basis"
    },
    "intended_basis": {
     "$ref": "#/$defs/basis"
    },
    "source_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "asserted_by": {
     "anyOf": [
      {
       "$ref": "#/$defs/principal"
      },
      {
       "type": "null"
      }
     ]
    },
    "asserted_at": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time"
    },
    "observed_on": {
     "type": [
      "string",
      "null"
     ],
     "format": "date"
    },
    "valid_from": {
     "type": [
      "string",
      "null"
     ],
     "format": "date"
    },
    "valid_to": {
     "type": [
      "string",
      "null"
     ],
     "format": "date"
    },
    "supersedes": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^urn:kos:assertion:"
    },
    "verified_by": {
     "$ref": "#/$defs/principal_or_null"
    },
    "verified_at": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time"
    },
    "confidence": {
     "enum": [
      "high",
      "medium",
      "low",
      null
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^urn:kos:assertion:[a-z0-9-]+(:[a-z0-9-]+)*$"
    },
    "qualifier": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "if": {
    "properties": {
     "basis": {
      "const": "awaiting"
     }
    }
   },
   "then": {
    "properties": {
     "source_ids": {
      "maxItems": 0
     }
    },
    "not": {
     "anyOf": [
      {
       "required": [
        "value"
       ]
      },
      {
       "required": [
        "valid_from"
       ]
      }
     ]
    }
   },
   "else": {
    "required": [
     "source_ids",
     "asserted_by",
     "asserted_at"
    ],
    "properties": {
     "source_ids": {
      "minItems": 1
     }
    }
   },
   "patternProperties": {
    "^x-": {}
   }
  },
  "governance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "owner",
    "classification",
    "contains_pii",
    "mnpi",
    "ci_legal_review"
   ],
   "properties": {
    "owner": {
     "$ref": "#/$defs/principal"
    },
    "steward": {
     "$ref": "#/$defs/principal_or_null"
    },
    "classification": {
     "enum": [
      "public",
      "internal",
      "confidential",
      "restricted"
     ]
    },
    "contains_pii": {
     "type": "boolean"
    },
    "mnpi": {
     "type": "boolean"
    },
    "ci_legal_review": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status"
     ],
     "properties": {
      "status": {
       "enum": [
        "not-required",
        "pending",
        "approved",
        "rejected"
       ]
      },
      "reviewer": {
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "type": [
        "string",
        "null"
       ],
       "format": "date"
      }
     },
     "patternProperties": {
      "^x-": {}
     }
    },
    "retention_class": {
     "type": [
      "string",
      "null"
     ]
    },
    "access_policy": {
     "type": "string"
    }
   },
   "patternProperties": {
    "^x-": {}
   }
  },
  "journey": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "title",
    "bank",
    "product",
    "persona",
    "customer_goal",
    "version",
    "as_of",
    "status",
    "governance",
    "stages",
    "moments"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/urn"
    },
    "title": {
     "type": "string"
    },
    "bank": {
     "type": "string"
    },
    "product": {
     "type": "string"
    },
    "persona": {
     "type": "string"
    },
    "segment": {
     "type": "string"
    },
    "lob": {
     "type": "string"
    },
    "customer_goal": {
     "type": "string"
    },
    "scope": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "starts": {
       "type": "string"
      },
      "ends": {
       "type": "string"
      },
      "excludes": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "patternProperties": {
      "^x-": {}
     }
    },
    "version": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "as_of": {
     "type": "string",
     "format": "date"
    },
    "status": {
     "enum": [
      "draft",
      "in-review",
      "published",
      "retired"
     ]
    },
    "basis": {
     "$ref": "#/$defs/basis"
    },
    "governance": {
     "$ref": "#/$defs/governance"
    },
    "stages": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "moments": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/moment"
     }
    },
    "variants": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/variant"
     }
    }
   },
   "patternProperties": {
    "^x-": {}
   }
  },
  "moment": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "code",
    "stage",
    "title",
    "customer_action",
    "touchpoints",
    "frontstage",
    "process",
    "controls",
    "applications",
    "capabilities",
    "kpis",
    "fail_points",
    "emotion",
    "hotspot",
    "evidence"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/urn"
    },
    "code": {
     "type": "string",
     "pattern": "^M[0-9]{2}$"
    },
    "stage": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "customer_action": {
     "type": [
      "string",
      "null"
     ]
    },
    "touchpoints": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "channel",
       "screen"
      ],
      "properties": {
       "channel": {
        "enum": [
         "mobile-app",
         "web",
         "branch",
         "contact-center",
         "chat",
         "sms",
         "email",
         "push",
         "atm",
         "partner"
        ]
       },
       "screen": {
        "type": "string"
       }
      },
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "frontstage": {
     "type": "string"
    },
    "process": {
     "$ref": "#/$defs/urn"
    },
    "controls": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/urn"
     }
    },
    "applications": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "interfaces": {
     "type": "array",
     "items": {
      "type": "string"
     }
