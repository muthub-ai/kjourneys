      "id": "attr-enroll-where",
      "stage": "setup",
      "name": "Where customers enroll",
      "datatype": "enum_list",
      "unit": null,
      "normalization": "All that apply",
      "allowed_values": [
        "mobile-app",
        "web",
        "branch",
        "standalone-app"
      ]
    },
    {
      "id": "attr-enroll-steps",
      "stage": "setup",
      "name": "Steps to enroll",
      "datatype": "integer",
      "unit": "screens",
      "normalization": "Count distinct screens from Zelle hub to first send"
    },
    {
      "id": "attr-payee-name-shown",
      "stage": "choose",
      "name": "Recipient name shown before send",
      "datatype": "boolean",
      "unit": null,
      "normalization": "Yes only if the registered name is shown before confirming"
    },
    {
      "id": "attr-new-payee-warning",
      "stage": "choose",
      "name": "New-payee scam warning",
      "datatype": "enum",
