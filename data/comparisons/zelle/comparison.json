      "allowed_values": [
        "none",
        "first-payment",
        "every-payment",
        "risk-based"
      ]
    },
    {
      "id": "attr-daily-limit",
      "stage": "send",
      "name": "Daily send limit",
      "datatype": "money",
      "unit": "USD",
      "normalization": "Lowest published standard-tier limit; record segment in qualifier"
    },
    {
      "id": "attr-stepup-trigger",
      "stage": "send",
      "name": "When step-up is triggered",
      "datatype": "text",
      "unit": null,
      "normalization": "Quote or paraphrase the bank's public wording, with source"
    },
    {
      "id": "attr-time-to-recipient",
      "stage": "move",
      "name": "Typical time to recipient",
      "datatype": "duration",
      "unit": "ISO 8601 duration",
      "normalization": "Typical time stated by the bank for enrolled recipients"
    },
    {
      "id": "attr-notifications",
      "stage": "confirm",
      "name": "Notifications offered",
      "datatype": "enum_list",
      "unit": null,
      "normalization": "All that apply",
      "allowed_values": [
