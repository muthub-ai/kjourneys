      "allowed_values": [
        "never",
        "only-if-unclaimed",
        "within-window",
        "always"
      ]
    },
    {
      "id": "attr-report-channels",
      "stage": "help",
      "name": "Channels to report a problem",
      "datatype": "enum_list",
      "unit": null,
      "normalization": "All that apply",
      "allowed_values": [
        "mobile-app",
        "web",
        "chat",
        "contact-center",
        "branch"
      ]
    },
    {
      "id": "attr-scam-reimbursement",
      "stage": "help",
      "name": "Scam reimbursement stance",
      "datatype": "text",
      "unit": null,
      "normalization": "Quote or paraphrase the bank's public wording, with source"
