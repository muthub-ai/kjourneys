[
  {
    "id": "met-enroll-start-conv",
    "name": "Zelle entry → enrollment start",
    "definition": "Share of first-time Zelle hub visitors who start enrollment",
    "formula": "enrollment_starts / first_time_hub_visits * 100",
    "unit": "percent",
    "grain": "customer",
    "period": "monthly",
    "direction": "increase",
    "source_system": "p2phb",
    "steward": null,
    "dq_status": "uncertified",
    "basis": "sample",
    "bank": "wells-fargo",
    "product": "zelle",
    "scale": "0-100"
  },
  {
    "id": "met-enroll-completion",
    "name": "Enrollment completion",
    "definition": "Share of started enrollments that register a token",
    "formula": "tokens_registered / enrollment_starts * 100",
    "unit": "percent",
    "grain": "customer",
    "period": "monthly",
    "direction": "increase",
    "source_system": "p2phb",
    "steward": null,
    "dq_status": "uncertified",
    "basis": "sample",
    "bank": "wells-fargo",
    "product": "zelle",
    "scale": "0-100"
  },
  {
    "id": "met-otp-delivery-p95",
    "name": "Code delivery p95",
    "definition": "95th percentile time from code request to SMS delivery receipt",
    "formula": "p95(delivered_at - requested_at)",
    "unit": "seconds",
    "grain": "event",
    "period": "daily",
    "direction": "decrease",
    "source_system": "notif",
    "steward": null,
    "dq_status": "uncertified",
    "basis": "sample",
    "bank": "wells-fargo",
    "product": "zelle"
  },
  {
    "id": "met-directory-lookup-p95",
    "name": "Directory lookup p95",
